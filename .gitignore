# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Data — do not commit large raw files (Design §4.1; pathway repo structure)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Large raw tweets dump kept out of git
Merged_Twitter_Data_IDsRemoved.csv

# Results artifacts are regenerable; keep the folder, ignore contents
results/*
!results/.gitkeep
# Keep the final report figure so REPORT.md renders on GitHub.
!results/cumulative_returns.png

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
